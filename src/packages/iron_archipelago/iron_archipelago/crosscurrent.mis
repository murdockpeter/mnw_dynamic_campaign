import random

##
# Globals
##
_debug_mode = False
_version = "0.0.0"
_msv = "0.113.1"
_author = "Codex"
_operation_type = OperationType.ASuW
_date_time = "2028/04/03 10:40:00"
_weather = EnvTools.GetRandomWeatherParameters()

# Civilians faction code
civ_fact = 0
# USA faction code
us_fact = 236
# PLAN faction code
ch_fact = 46

# Virginia Block III DB ID
virginia_id = 1015
# Arleigh Burke DDG DB ID
arleigh_id = 294
# P-8 Poseidon DB ID
p8_id = 2705
# Type 054A Frigate DB ID
t054a_id = 1965
# Type 055 DDG DB ID
t055_id = 3883
# Harbin Z-9 DB ID
harbin_id = 60

# Cargo ships
cargo_ids = [
99992101, 99992105, 99992106, 99992107, 99992108,
99992109, 99992110, 99992111, 99992201, 99992202,
99992203, 99992204, 99992205, 99992206, 99992207,
99992208, 99992209, 99992210, 99992211, 99992301,
99992302, 99992303, 99992304, 99992305, 99992306,
99992307, 99992308, 99992309, 99992310, 99992311,
99992312, 99992313, 99992314, 99992315, 99992401
]


def _get_random_cargo():
    return cargo_ids[random.randrange(0, len(cargo_ids))]


# Balintang / southern Luzon Strait reference points
player_spawn_pos = GC(20.180000, 122.780000)
datum_pos = GC(20.520000, 122.050000)
lead_ddg_pos = GC(20.760000, 121.780000)
escort_ffg_pos = GC(20.620000, 121.680000)
barrier_ffg_pos = GC(20.880000, 121.960000)
sag_dest = GC(20.260000, 122.520000)
barrier_dest = GC(20.420000, 122.660000)
helo_patrol_pos = GC(20.700000, 122.180000)
friendly_ddg_pos = GC(19.980000, 123.160000)
friendly_ddg_dest = GC(20.320000, 122.880000)
p8_spawn_pos = GC(21.080000, 123.020000)
battle_area_center = GC(20.600000, 122.180000)
support_station_pos = GC(20.300000, 122.760000)
barrier_poi_pos = GC(20.520000, 122.520000)
withdrawal_poi_pos = GC(20.080000, 123.080000)

##
# Diplomacy
##
_diplomacy.AddFactions([civ_fact, us_fact, ch_fact])
_diplomacy.SetTensionLevel(TensionLevel.Increased).SetMissionROE(RulesOfEngagement.Free)
_diplomacy.SetStatus(civ_fact).SetStatus(us_fact).SetStatus(ch_fact, CoalitionStatus.Enemy)

##
# Objectives
##
objectives = [
    Obj(_objectives["primary_withdraw_intact"], True).SetStatus(ObjectiveStatus.InProgress),
]

##
# Player
##
player_spawn_zone = _Z.Circular("Player Spawn Zone", player_spawn_pos, 1000)
player_props = Element.Props.FromElementID(us_fact, "(Player) Virginia B3", ElementCategory.Submarine, virginia_id, player_spawn_zone.RandomPosition())
player_element = Element(player_props).SetElevation(-150).SetHeading(285).SetPlayable().SetScope(Global.Scope.Player)
player_spawn_process = _P.Element.Spawn(_mission_started, player_element, player_element.Position)

player_mk48_arsenal_process = _P.Element.Arsenal(player_spawn_process, player_element, BaseCategory.Subsurface, ElementCategory.Torpedo, 1712, 12)
player_mk3_arsenal_process = _P.Element.Arsenal(player_mk48_arsenal_process, player_element, BaseCategory.Subsurface, ElementCategory.Expendable, 126, 12)
player_mk4_arsenal_process = _P.Element.Arsenal(player_mk3_arsenal_process, player_element, BaseCategory.Subsurface, ElementCategory.Expendable, 2458, 12)

preloads = []

for i in range(4):
    preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Torpedo, 1712))

for j in range(14):
    if j <= 7:
        preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Expendable, 126))
    else:
        preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Expendable, 2458))

player_preload_process = _P.Element.PreloadArsenal(player_mk4_arsenal_process, player_element, preloads)

##
# Messages
##
messageModel = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "TASKING ORDER",
    _messages["mission_objectives"]
)
datum_poi = PointOfInterest("PLAN Lead Datum", Waypoint(datum_pos))
support_station_poi = PointOfInterest("USS Spruance Support Station", Waypoint(support_station_pos))
barrier_poi = PointOfInterest("Likely Barrier Track", Waypoint(barrier_poi_pos))
withdrawal_poi = PointOfInterest("Withdrawal Box", Waypoint(withdrawal_poi_pos))
messageModel.AttachPOIs([datum_poi, support_station_poi, barrier_poi, withdrawal_poi])
message_process = _P.Message(player_spawn_process, messageModel)

##
# Transmissions
##
sat_spawn_zone = _Z.Circular("Sat Spawn Zone", player_spawn_pos, 10000)
sat_props = Element.Props.FromDatabaseID(us_fact, "MUOS", ElementCategory.SpaceElement, 1, sat_spawn_zone.RandomPosition())
sat_element = Element(sat_props).SetElevation(500)
sat_spawn_process = _P.Element.Spawn(player_spawn_process, sat_element, sat_element.Position)

transmission = Transmission.Create(EMFTools.Protocol.Link_16, _date_time, 60, 10, 500, EMFTools.MicroWaveBands.UHF)
transmission_process = _P.Element.Radio(sat_spawn_process, sat_element, transmission)

##
# Friendly support
##
friendly_ddg_props = Element.Props.FromDatabaseID(us_fact, "USS Spruance", ElementCategory.Ship, arleigh_id, friendly_ddg_pos)
friendly_ddg = Element(friendly_ddg_props).SetElevation(0).SetHeading(310).SetHVU(True)
friendly_ddg_spawn = _P.Element.Spawn(player_spawn_process, friendly_ddg, friendly_ddg.Position)
friendly_ddg_plot = _P.Element.Plot(friendly_ddg_spawn, friendly_ddg, Waypoint(friendly_ddg_dest))

p8_props = Element.Props.FromDatabaseID(us_fact, "P-8A Poseidon", ElementCategory.Aircraft, p8_id, p8_spawn_pos)
p8_element = Element(p8_props).SetElevation(5200).SetHeading(255)
p8_spawn = _P.Element.Spawn(friendly_ddg_plot, p8_element, p8_element.Position)
p8_plot = _P.Element.Plot(p8_spawn, p8_element, Waypoint(GC(20.640000, 122.420000)))

##
# Ambient biologics
##
bios_zone = _Z.Circular("Biologics Zone", battle_area_center, 90000)

bio_0_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 0", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_0_element = Element(bio_0_props).SetElevation(-60).SetHeading(random.randrange(0, 359))
bio_0_spawn = _P.Element.Spawn(player_spawn_process, bio_0_element, bio_0_element.Position)

bio_1_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 1", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_1_element = Element(bio_1_props).SetElevation(-100).SetHeading(random.randrange(0, 359))
bio_1_spawn = _P.Element.Spawn(player_spawn_process, bio_1_element, bio_1_element.Position)

bio_2_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 2", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_2_element = Element(bio_2_props).SetElevation(-160).SetHeading(random.randrange(0, 359))
bio_2_spawn = _P.Element.Spawn(player_spawn_process, bio_2_element, bio_2_element.Position)

##
# Civilian traffic
##
civ_zone = _Z.Circular("Civilian Traffic Zone", battle_area_center, 110000)

cargo_0_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 1", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_0_element = Element(cargo_0_props).SetHeading(random.randrange(180, 280))
cargo_0_spawn = _P.Element.Spawn(player_spawn_process, cargo_0_element, cargo_0_element.Position)

cargo_1_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 2", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_1_element = Element(cargo_1_props).SetHeading(random.randrange(180, 280))
cargo_1_spawn = _P.Element.Spawn(player_spawn_process, cargo_1_element, cargo_1_element.Position)

cargo_2_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 3", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_2_element = Element(cargo_2_props).SetHeading(random.randrange(180, 280))
cargo_2_spawn = _P.Element.Spawn(player_spawn_process, cargo_2_element, cargo_2_element.Position)

##
# Hostile PLAN screen
##
t055_props = Element.Props.FromDatabaseID(ch_fact, "PLAN Lead DDG", ElementCategory.Ship, t055_id, lead_ddg_pos)
t055_element = Element(t055_props).SetElevation(0).SetHeading(145).SetHVU(True)
t055_spawn = _P.Element.Spawn(player_spawn_process, t055_element, t055_element.Position)
t055_plot = _P.Element.Plot(t055_spawn, t055_element, Waypoint(sag_dest))

t054a_props = Element.Props.FromDatabaseID(ch_fact, "PLAN Escort FFG", ElementCategory.Ship, t054a_id, escort_ffg_pos)
t054a_element = Element(t054a_props).SetElevation(0).SetHeading(145).SetHVU(True)
t054a_spawn = _P.Element.Spawn(t055_plot, t054a_element, t054a_element.Position)
t054a_plot = _P.Element.Plot(t054a_spawn, t054a_element, Waypoint(GC(20.180000, 122.360000)))

barrier_ffg_props = Element.Props.FromDatabaseID(ch_fact, "PLAN Barrier FFG", ElementCategory.Ship, t054a_id, barrier_ffg_pos)
barrier_ffg_element = Element(barrier_ffg_props).SetElevation(0).SetHeading(205)
barrier_ffg_spawn = _P.Element.Spawn(t054a_plot, barrier_ffg_element, barrier_ffg_element.Position)
barrier_ffg_plot = _P.Element.Plot(barrier_ffg_spawn, barrier_ffg_element, Waypoint(barrier_dest))

harbin_props = Element.Props.FromDatabaseID(ch_fact, "PLAN Z-9 Screen", ElementCategory.Aircraft, harbin_id, helo_patrol_pos)
harbin_element = Element(harbin_props).SetElevation(950).SetHeading(190).SetHVU(True)
harbin_spawn = _P.Element.Spawn(barrier_ffg_plot, harbin_element, harbin_element.Position)
harbin_plot = _P.Element.Plot(harbin_spawn, harbin_element, Waypoint(GC(20.460000, 122.560000)))

##
# Objective changes
##
withdrawal_antenna_trigger = _T.AntennasRaised(True)
player_element.NotifyOnAntennaRaised(withdrawal_antenna_trigger)
withdrawal_complete = _P.Objective.Status(withdrawal_antenna_trigger, objectives[0], ObjectiveStatus.Completed)

player_death_trigger = _T.Manual()
player_nop_trigger = _T.NonOperational()
player_element.NotifyUponDeath(player_death_trigger)
player_element.NotifyNonOperational(player_nop_trigger)
player_lost = _T.Or([player_death_trigger, player_nop_trigger])
player_fail = _P.Objective.Status(player_lost, objectives[0], ObjectiveStatus.Failed)

##
# Outcomes
##
out_trigger = _T.Objective(objectives)
end_trigger = _T.Manual()
outcome = Out(out_trigger, end_trigger, us_fact)

end_message_model = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "MISSION STATUS UPDATE",
    _messages["mission_success"]
)
end_message_process = _P.Message(out_trigger, end_message_model)

end_transmission = Transmission.Create(EMFTools.Protocol.Link_16, _date_time, 60, 10, 500, EMFTools.MicroWaveBands.UHF)
end_transmission_process = _P.Element.Radio(end_message_process, sat_element, end_transmission)

import random

##
# Globals
##
_debug_mode = False
_version = "0.0.0"
_msv = "0.113.1"
_author = "Codex"
_operation_type = OperationType.ASW
_date_time = "2028/03/16 04:20:00"
_weather = EnvTools.GetRandomWeatherParameters()

# Civilians faction code
civ_fact = 0
# USA faction code
us_fact = 236
# Russia faction code
rus_fact = 183
# PLAN faction code
ch_fact = 46

# Virginia Block III DB ID
virginia_id = 1015
# Arleigh Burke DDG DB ID
arleigh_id = 294
# P-8 Poseidon DB ID
p8_id = 2705
# Akula / escort DB ID
suka_b_id = 34
# Type 054A Frigate DB ID
t054a_id = 1965
# Type 055 DDG DB ID
t055_id = 3883
# Harbin Z-9 DB ID
harbin_id = 60

# Cargo ships
cargo_ids = [
99992101, 99992105, 99992106, 99992107, 99992108,
99992109, 99992110, 99992111, 99992201, 99992202,
99992203, 99992204, 99992205, 99992206, 99992207,
99992208, 99992209, 99992210, 99992211, 99992301,
99992302, 99992303, 99992304, 99992305, 99992306,
99992307, 99992308, 99992309, 99992310, 99992311,
99992312, 99992313, 99992314, 99992315, 99992401
]
def _get_random_cargo():
    return cargo_ids[random.randrange(0, len(cargo_ids))]

# Scenario reference points
player_spawn_pos = GC(16.930000, 118.220000)
withdrawal_zone_pos = GC(16.140000, 117.340000)
withdrawal_lane_pos = GC(16.420000, 117.620000)
datum_pos = GC(16.620000, 117.940000)
akula_spawn_pos = GC(16.610000, 117.760000)
surface_group_pos = GC(17.050000, 117.180000)
surface_group_dest = GC(16.480000, 117.940000)
friendly_ddg_pos = GC(15.980000, 117.040000)
friendly_ddg_dest = GC(16.220000, 117.260000)
p8_spawn_pos = GC(16.260000, 117.760000)
battle_area_center = GC(16.560000, 117.760000)
coastal_emitter_pos = GC(16.834519, 112.340301)

##
# Diplomacy
##
_diplomacy.AddFactions([civ_fact, us_fact, rus_fact, ch_fact])
_diplomacy.SetTensionLevel(TensionLevel.Increased).SetMissionROE(RulesOfEngagement.Free)
_diplomacy.SetStatus(civ_fact).SetStatus(us_fact).SetStatus(rus_fact, CoalitionStatus.Enemy).SetStatus(ch_fact, CoalitionStatus.Enemy)

##
# Objectives
##
objectives = [
    Obj(_objectives["primary_withdraw_intact"], True).SetStatus(ObjectiveStatus.InProgress),
]

##
# Player
##
player_spawn_zone = _Z.Circular("Player Spawn Zone", player_spawn_pos, 1200)
player_props = Element.Props.FromElementID(us_fact, "(Player) Virginia B3", ElementCategory.Submarine, virginia_id, player_spawn_zone.RandomPosition())
player_element = Element(player_props).SetElevation(-380).SetHeading(215).SetPlayable().SetScope(Global.Scope.Player)
player_spawn_process = _P.Element.Spawn(_mission_started, player_element, player_element.Position)

player_mk48_arsenal_process = _P.Element.Arsenal(player_spawn_process, player_element, BaseCategory.Subsurface, ElementCategory.Torpedo, 1712, 12)
player_mk3_arsenal_process = _P.Element.Arsenal(player_mk48_arsenal_process, player_element, BaseCategory.Subsurface, ElementCategory.Expendable, 126, 12)
player_mk4_arsenal_process = _P.Element.Arsenal(player_mk3_arsenal_process, player_element, BaseCategory.Subsurface, ElementCategory.Expendable, 2458, 12)

preloads = []

for i in range(3):
    preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Torpedo, 1712))

for j in range(12):
    if j <= 5:
        preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Expendable, 126))
    else:
        preloads.append(ArsenalPacket(BaseCategory.Subsurface, ElementCategory.Expendable, 2458))

player_preload_process = _P.Element.PreloadArsenal(player_mk4_arsenal_process, player_element, preloads)

##
# Messages
##
messageModel = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "TASKING ORDER",
    _messages["mission_objectives"]
)
datum_poi = PointOfInterest("Last Fight Datum", Waypoint(datum_pos))
lane_poi = PointOfInterest("Withdrawal Lane", Waypoint(withdrawal_lane_pos))
withdrawal_poi = PointOfInterest("Withdrawal Box", Waypoint(withdrawal_zone_pos))
emitter_poi = PointOfInterest("Coastal Emitter", Waypoint(coastal_emitter_pos))
messageModel.AttachPOIs([datum_poi, lane_poi, withdrawal_poi, emitter_poi])
message_process = _P.Message(player_spawn_process, messageModel)

##
# Transmissions
##
sat_spawn_zone = _Z.Circular("Sat Spawn Zone", player_spawn_pos, 10000)
sat_props = Element.Props.FromDatabaseID(us_fact, "MUOS", ElementCategory.SpaceElement, 1, sat_spawn_zone.RandomPosition())
sat_element = Element(sat_props).SetElevation(500)
sat_spawn_process = _P.Element.Spawn(player_spawn_process, sat_element, sat_element.Position)

transmission = Transmission.Create(EMFTools.Protocol.Link_16, _date_time, 60, 10, 500, EMFTools.MicroWaveBands.UHF)
transmission_process = _P.Element.Radio(sat_spawn_process, sat_element, transmission)

##
# Friendly forces
##
ddg_props = Element.Props.FromDatabaseID(us_fact, "USS Spruance", ElementCategory.Ship, arleigh_id, friendly_ddg_pos)
ddg_element = Element(ddg_props).SetElevation(0).SetHeading(45).SetHVU(True)
ddg_spawn = _P.Element.Spawn(player_spawn_process, ddg_element, ddg_element.Position)

ddg_formation_props = ASWFormation.ASWFormationProps()
ddg_formation_props.SetCourse(45.0)
ddg_squad = Squadron(us_fact, "Withdrawal Screen", [ddg_element], friendly_ddg_pos, ddg_formation_props)
ddg_plot = _P.Squadron.Plot(ddg_spawn, ddg_squad, Waypoint(friendly_ddg_dest))

p8_props = Element.Props.FromDatabaseID(us_fact, "P-8A Poseidon", ElementCategory.Aircraft, p8_id, p8_spawn_pos)
p8_element = Element(p8_props).SetElevation(5000).SetHeading(230)
p8_spawn = _P.Element.Spawn(ddg_plot, p8_element, p8_element.Position)

##
# Ambient biologics
##
bios_zone = _Z.Circular("Biologics Zone", battle_area_center, 70000)

bio_0_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 0", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_0_element = Element(bio_0_props).SetElevation(-70).SetHeading(random.randrange(0, 359))
bio_0_spawn = _P.Element.Spawn(p8_spawn, bio_0_element, bio_0_element.Position)

bio_1_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 1", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_1_element = Element(bio_1_props).SetElevation(-110).SetHeading(random.randrange(0, 359))
bio_1_spawn = _P.Element.Spawn(p8_spawn, bio_1_element, bio_1_element.Position)

bio_2_props = Element.Props.FromDatabaseID(civ_fact, "Biologic 2", ElementCategory.Biologic, 1, bios_zone.RandomPosition())
bio_2_element = Element(bio_2_props).SetElevation(-180).SetHeading(random.randrange(0, 359))
bio_2_spawn = _P.Element.Spawn(p8_spawn, bio_2_element, bio_2_element.Position)

##
# Civilian traffic
##
civ_zone = _Z.Circular("Civilian Traffic Zone", battle_area_center, 100000)

cargo_0_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 1", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_0_element = Element(cargo_0_props).SetHeading(random.randrange(205, 275))
cargo_0_spawn = _P.Element.Spawn(p8_spawn, cargo_0_element, cargo_0_element.Position)

cargo_1_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 2", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_1_element = Element(cargo_1_props).SetHeading(random.randrange(205, 275))
cargo_1_spawn = _P.Element.Spawn(p8_spawn, cargo_1_element, cargo_1_element.Position)

cargo_2_props = Element.Props.FromDatabaseID(civ_fact, "Merchant 3", ElementCategory.Ship, _get_random_cargo(), civ_zone.RandomPosition())
cargo_2_element = Element(cargo_2_props).SetHeading(random.randrange(205, 275))
cargo_2_spawn = _P.Element.Spawn(p8_spawn, cargo_2_element, cargo_2_element.Position)

##
# Hostile submarine
##
akula_spawn_zone = _Z.Circular("Akula Spawn Zone", akula_spawn_pos, 9000)
akula_props = Element.Props.FromDatabaseID(rus_fact, "Akula Hunter", ElementCategory.Submarine, suka_b_id, akula_spawn_zone.RandomPosition())
akula_element = Element(akula_props).SetElevation(-560).SetHeading(70).SetHVU(True)
akula_spawn = _P.Element.Spawn(cargo_2_spawn, akula_element, akula_element.Position)
akula_dive = _P.Element.Dive(akula_spawn, akula_element)

akula_plot = _P.Element.Plot(akula_dive, akula_element, Waypoint(player_spawn_pos))

##
# Hostile surface group
##
surface_zone = _Z.Circular("Surface Group Zone", surface_group_pos, 9000)

t055_props = Element.Props.FromDatabaseID(ch_fact, "Regional DDG", ElementCategory.Ship, t055_id, surface_zone.RandomPosition())
t055_element = Element(t055_props).SetElevation(0).SetHeading(125)
t055_spawn = _P.Element.Spawn(akula_plot, t055_element, t055_element.Position)

t054a_props = Element.Props.FromDatabaseID(ch_fact, "Regional Frigate", ElementCategory.Ship, t054a_id, surface_zone.RandomPosition())
t054a_element = Element(t054a_props).SetElevation(0).SetHeading(125)
t054a_spawn = _P.Element.Spawn(t055_spawn, t054a_element, t054a_element.Position)

harbin_props = Element.Props.FromDatabaseID(ch_fact, "Regional Helo", ElementCategory.Aircraft, harbin_id, surface_zone.RandomPosition())
harbin_element = Element(harbin_props).SetElevation(0).SetHeading(125)
harbin_spawn = _P.Element.Spawn(t054a_spawn, harbin_element, harbin_element.Position)

surface_formation_props = ASWFormation.ASWFormationProps()
surface_formation_props.SetCourse(125.0)
surface_squad = Squadron(ch_fact, "Closing Net Group", [t055_element, t054a_element, harbin_element], surface_group_pos, surface_formation_props)
surface_plot = _P.Squadron.Plot(harbin_spawn, surface_squad, Waypoint(surface_group_dest))

##
# Objective changes
##
withdrawal_zone = _Z.Circular("Withdrawal Zone", withdrawal_zone_pos, 5000)
withdrawal_zone_props = _T.Zone.Props(_T.ZoneEvent.IsInside, _T.AnyAll.Any)
withdrawal_zone_trigger = _T.Zone(withdrawal_zone, [player_element], withdrawal_zone_props)
withdrawal_antenna_trigger = _T.AntennasRaised(True)
player_element.NotifyOnAntennaRaised(withdrawal_antenna_trigger)
withdrawal_complete = _P.Objective.Status(withdrawal_antenna_trigger, objectives[0], ObjectiveStatus.Completed)

player_death_trigger = _T.Manual()
player_nop_trigger = _T.NonOperational()
player_element.NotifyUponDeath(player_death_trigger)
player_element.NotifyNonOperational(player_nop_trigger)
player_lost = _T.Or([player_death_trigger, player_nop_trigger])
player_fail = _P.Objective.Status(player_lost, objectives[0], ObjectiveStatus.Failed)

##
# Dynamic cueing messages
##
akula_classified_trigger = _T.ElementClassification(None, CategoryID.Submarine, StandardIdentity.Hostile)
player_element.NotifyOnClassification(akula_classified_trigger)

cue_message_model = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "P-8 CUEING UPDATE",
    _messages["cueing_update"]
)
cue_message = _P.Message(akula_classified_trigger, cue_message_model)

surface_group_report_model = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "SURFACE THREAT UPDATE",
    _messages["support_group_report"]
)
surface_group_report = _P.Message(surface_plot, surface_group_report_model)

##
# Outcomes
##
out_trigger = _T.Objective(objectives)
end_trigger = _T.Manual()
outcome = Out(out_trigger, end_trigger, us_fact)

end_message_model = MessageModel(
    EMFTools.Protocol.Link_16,
    EMFTools.MicroWaveBands.UHF,
    _date_time,
    MessagePriority.High,
    _messages["mission_from"],
    _messages["mission_to"],
    "MISSION STATUS UPDATE",
    _messages["mission_success"]
)
end_message_process = _P.Message(out_trigger, end_message_model)

end_transmission = Transmission.Create(EMFTools.Protocol.Link_16, _date_time, 60, 10, 500, EMFTools.MicroWaveBands.UHF)
end_transmission_process = _P.Element.Radio(end_message_process, sat_element, end_transmission)

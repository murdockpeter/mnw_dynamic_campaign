{
  "name": "mnw-dynamic-campaign",
  "version": "0.1.4",
  "description": "Modern Naval Warfare dynamic campaign generator with legacy scripts and a portable Electron path.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.0"
  },
  "scripts": {
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder",
    "desktop:release": "electron-builder --publish always",
    "portable:build": "node ./portable/build-package.mjs",
    "portable:deploy": "node ./portable/deploy-package.mjs",
    "portable:export-ui": "node ./portable/export-ui-state.mjs",
    "portable:ingest": "node ./portable/ingest-result.mjs",
    "portable:generate": "node ./portable/generate-campaign.mjs",
    "report:variance": "node ./tools/variance-report.mjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.waveops.mnwdynamiccampaign",
    "productName": "MNW Dynamic Campaign Console",
    "files": [
      "electron/**/*",
      "portable/**/*",
      "shared/**/*",
      "ui/**/*",
      "engine/**/*",
      "campaigns/**/*",
      "modules/**/*",
      "storage/**/*",
      "src/**/*",
      "generated/**/*",
      "state/**/*",
      "README.md",
      "DEVELOPER_GUIDE.md",
      "DESKTOP_APP_GUIDE.md"
    ],
    "extraResources": [
      {
        "from": "DESKTOP_APP_GUIDE.md",
        "to": "docs/DESKTOP_APP_GUIDE.md"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "campaigns",
        "to": "seed/campaigns"
      },
      {
        "from": "src",
        "to": "seed/src"
      },
      {
        "from": "parsers",
        "to": "seed/parsers"
      },
      {
        "from": "tests",
        "to": "seed/tests"
      }
    ],
    "directories": {
      "buildResources": "electron/resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "murdockpeter",
        "repo": "mnw_dynamic_campaign"
      }
    ],
    "win": {
      "icon": "electron/resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/resources/icon.ico",
      "uninstallerIcon": "electron/resources/icon.ico",
      "installerHeaderIcon": "electron/resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    }
  }
}
